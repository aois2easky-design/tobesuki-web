{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tobesuki",
  "main": "./worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tobesuki",
  "main": "./worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "5b56e852-a788-4579-8e68-e2d2e509ddf4"
    }
  ]
}
